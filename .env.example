# Server-only secret. Do not prefix this with NEXT_PUBLIC_.
# Read in:
#   app/api/stocks/route.ts
#   app/api/news/route.ts
# Create a key at https://finnhub.io/register and paste it below.
# Local file name: .env.local (copy this example). On Vercel, add the same
# name under Project Settings → Environment Variables.
FINNHUB_API_KEY=

# Optional. Used only for canonical and social preview links in app/layout.tsx.
# Defaults to https://quant-view-screener.vercel.app when unset.
# NEXT_PUBLIC_SITE_URL=https://quant-view-screener.vercel.app
